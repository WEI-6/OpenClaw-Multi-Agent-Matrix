{
  "agents": {
    "defaults": {
      "workspace": "E:\\projects\\OpenClaw-Multi-Agent-Matrix\\workspace",
      "model": {
        "primary": "<your-main-model-id>"
      },
      "memorySearch": {
        "provider": "local"
      }
    },
    "list": [
      {
        "id": "main"
      },
      {
        "id": "res_1",
        "workspace": "E:\\projects\\OpenClaw-Multi-Agent-Matrix\\workspace\\agents\\res_1"
      },
      {
        "id": "res_2",
        "workspace": "E:\\projects\\OpenClaw-Multi-Agent-Matrix\\workspace\\agents\\res_2"
      },
      {
        "id": "exe_1",
        "workspace": "E:\\projects\\OpenClaw-Multi-Agent-Matrix\\workspace\\agents\\exe_1"
      },
      {
        "id": "exe_2",
        "workspace": "E:\\projects\\OpenClaw-Multi-Agent-Matrix\\workspace\\agents\\exe_2"
      },
      {
        "id": "dbg_1",
        "workspace": "E:\\projects\\OpenClaw-Multi-Agent-Matrix\\workspace\\agents\\dbg_1"
      },
      {
        "id": "dbg_2",
        "workspace": "E:\\projects\\OpenClaw-Multi-Agent-Matrix\\workspace\\agents\\dbg_2"
      },
      {
        "id": "dbg_3",
        "workspace": "E:\\projects\\OpenClaw-Multi-Agent-Matrix\\workspace\\agents\\dbg_3"
      },
      {
        "id": "judge",
        "workspace": "E:\\projects\\OpenClaw-Multi-Agent-Matrix\\workspace\\agents\\judge"
      }
    ]
  },
  "models": {
    "mode": "merge",
    "providers": {
      "<provider-id>": {
        "baseUrl": "<your-openai-compatible-endpoint>",
        "apiKey": "<your-api-key>",
        "models": [
          {
            "id": "<model-id>",
            "name": "<Model Display Name>"
          }
        ]
      }
    }
  },
  "gateway": {
    "mode": "local",
    "auth": {
      "mode": "token",
      "token": "<generate-a-token>"
    },
    "port": 18789
  }
}
